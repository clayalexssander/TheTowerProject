# Configurações do Servidor
PORT=3000

# HTTPS - Defina como 'true' para usar HTTPS com certificados auto-assinados (cert.pem e key.pem)
# Padrão: false (usa HTTP)
USE_HTTPS=false

# HTTPS - Deixe em branco para usar certificados auto-assinados locais (cert.pem e key.pem)
# HTTPS_CERT=/caminho/para/seu/cert.pem
# HTTPS_KEY=/caminho/para/seu/key.pem

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=thetower_db

# Email para relatórios financeiros automáticos
FINANCE_REPORT_EMAIL=
FINANCE_REPORT_ENABLED=false

# Outras configurações
NODE_ENV=development
